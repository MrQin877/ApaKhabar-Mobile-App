# Local development: leave blank. Expo LAN host is detected automatically on port 8088.
# Start with: npx expo start --lan --clear
# Public configuration only; never put secrets here.
EXPO_PUBLIC_API_BASE_URL=

# Deployed environments: set the complete HTTPS API root, including /api.
# EXPO_PUBLIC_API_BASE_URL=https://YOUR_APP.azurewebsites.net/api
# Deployed URLs take priority; stale private LAN URLs are ignored in development.
# Restart Expo with --clear after changes; rebuild deployed apps.
