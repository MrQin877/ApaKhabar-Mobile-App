# Copy to .env and set your laptop Wi-Fi IPv4 address for a physical phone.
# Leave blank to derive the Expo LAN host automatically (Docker port 8088).
# Complete API root, including /api. Public configuration: never put secrets here.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_WIFI_IP:8088/api

# For Azure, replace the value above with your deployed HTTPS API root:
# EXPO_PUBLIC_API_BASE_URL=https://YOUR_APP.azurewebsites.net/api
# Restart Expo with --clear after changing the URL; rebuild deployed apps.
